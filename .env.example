# Copiar a .env y rellenar. Nunca commitear .env.
# Postgres local levantado por infra/docker-compose.yml

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=nexxus_dev
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Un rol, una conexión. Nunca se usa el superusuario desde la app.

# Dueño del esquema. Solo ejecuta migraciones.
DATABASE_URL_MIGRATOR=postgres://migrator:change-me@localhost:5433/nexxus_dev

# Endpoints de registro, login, refresh y logout. Solo tablas del esquema auth.
DATABASE_URL_AUTH=postgres://auth_service:change-me@localhost:5433/nexxus_dev

# Resto de la API. Tablas de negocio con RLS por app.user_id.
DATABASE_URL_APP=postgres://app_user:change-me@localhost:5433/nexxus_dev

# API (etapa 2). El secreto debe tener 32 caracteres o más.
BETTER_AUTH_SECRET=change-me-32-characters-minimum-secret
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:8081
